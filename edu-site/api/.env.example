# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_LOG_LEVEL=info

# ─── Neon Serverless Postgres (Free tier: 0.5 GB) ────────────────────────────
# Get the connection string from your Neon project dashboard.
# Format: postgresql+asyncpg://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# ─── Qdrant Cloud (Free tier: 1 GB vectors, free forever) ────────────────────
# Get from https://cloud.qdrant.io/  →  your cluster's "Data Plane" URL + API key.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=bridge_balance_chapters

# ─── LLM provider ────────────────────────────────────────────────────────────
# Which provider the backend uses for chat, translation, personalization.
# Allowed values: none | groq | gemini | together | ollama | deepseek | openai
# Default "none" refuses to start the LLM stack and points to docs/llm-providers.md.
LLM_PROVIDER=none

# Per-provider credentials (only the one matching LLM_PROVIDER is read):
GROQ_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=              # only if you change LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434

# ─── Embedding provider ──────────────────────────────────────────────────────
# Same provider list as above, plus "huggingface" (self-hosted sentence-transformers).
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # used if EMBEDDING_PROVIDER=huggingface

# ─── better-auth (Phase B; safe to leave blank for Phase A) ──────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000

# ─── Optional, later phases — DO NOT enable until you reach the phase ────────
STRIPE_SECRET_KEY=            # Phase C — payments
STRIPE_WEBHOOK_SECRET=
CLOUDFLARE_R2_ACCESS_KEY=     # Phase C — product downloads
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
RESEND_API_KEY=               # Phase B — transactional email
INNGEST_EVENT_KEY=            # Phase C — async jobs
INNGEST_SIGNING_KEY=
