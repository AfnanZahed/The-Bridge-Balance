# ─── Root .env.example ──────────────────────────────────────────────────────
# This file documents every secret the platform might need across all phases.
# Phase A: NO secrets required. The backend boots with `LLM_PROVIDER=none`.
#
# Copy this file to `.env` (gitignored) when you start wiring each phase.
# Service-specific credentials live in `edu-site/api/.env` (FastAPI reads).

# ─── FastAPI backend (Phase A) ───────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# Default: refuses every LLM call. Change when Phase B wires chat/translation.
LLM_PROVIDER=none
EMBEDDING_PROVIDER=none

# ─── Phase B — Auth (better-auth.com) ────────────────────────────────────────
BETTER_AUTH_SECRET=

# ─── Phase B — Database (Neon Postgres, 0.5 GB free) ────────────────────────
DATABASE_URL=

# ─── Phase B — Vector search (Qdrant Cloud, 1 GB free) ──────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ─── Phase B — LLM provider (pick ONE; see edu-site/docs/llm-providers.md) ──
GROQ_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=              # only if you set LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434

# ─── Phase C — Payments (Stripe) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Phase C — Product downloads (Cloudflare R2, 10 GB free) ────────────────
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=

# ─── Phase C — Email (Resend, 3k emails/mo free) ─────────────────────────────
RESEND_API_KEY=

# ─── Phase C — Async jobs (Inngest, 25k runs/mo free) ───────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
